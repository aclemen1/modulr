# syntax=docker/dockerfile:1.7
#
# modulr dev image — R 4.5.3
#
# Mirrors dev/Dockerfile.r441. Used to validate the cross-version test
# matrix against the most recent R release, which is where the
# modulr::browser RSTEP bug was first reported.
FROM rocker/r-ver:4.5.3

ARG CRAN_SNAPSHOT="https://packagemanager.posit.co/cran/2026-01-15"

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git less libcurl4-openssl-dev libssl-dev \
      libxml2-dev make pandoc vim-tiny \
 && rm -rf /var/lib/apt/lists/*

RUN echo "options(repos = c(CRAN = '${CRAN_SNAPSHOT}'))" \
      >> /usr/local/lib/R/etc/Rprofile.site

RUN R -e "install.packages(c( \
      'assertthat','callr','digest','httr','jsonlite','knitr','memoise', \
      'pooh','rmarkdown','testthat','withr','yaml','rstudioapi','lintr','covr'))"

ENV _R_CHECK_LENGTH_1_LOGIC2_=true \
    _R_CHECK_LENGTH_1_CONDITION_=true \
    R_LIBS_USER=/root/R/library

RUN mkdir -p /root/R/library /pkg
WORKDIR /pkg

CMD ["sleep", "infinity"]
